{
  "name": "GitHub Trending Repos Morning Brief",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      },
      "id": "787c9f80-9999-4c12-a7f1-8f9f098c9f80",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/search/repositories",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQueryParameters": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "topic:javascript"
            },
            {
              "name": "sort",
              "value": "stars"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "10"
            }
          ]
        },
        "options": {}
      },
      "id": "e4f8d2b0-8888-4e12-b7f1-8f9f098c9f80",
      "name": "Fetch GitHub Repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        300,
        300
      ],
      "credentials": {
        "githubApi": {
          "id": "1",
          "name": "GitHub API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all()[0].json.items;\nconst top5 = items.slice(0, 5).map(repo => ({\n  name: repo.name,\n  full_name: repo.full_name,\n  description: repo.description,\n  stars: repo.stargazers_count,\n  url: repo.html_url,\n  language: repo.language\n}));\nreturn top5;"
      },
      "id": "d3c7b1a0-7777-4d12-c7f1-8f9f098c9f80",
      "name": "Transform Repos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $json.full_name + '/readme' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {
          "continueOnFail": true
        }
      },
      "id": "c2b6a090-6666-4e12-d7f1-8f9f098c9f80",
      "name": "Enrich Top Repo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        700,
        300
      ],
      "credentials": {
        "githubApi": {
          "id": "1",
          "name": "GitHub API"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $node[\"Transform Repos\"].json.stars }}",
              "operation": "largerEqual",
              "value2": 1000
            }
          ]
        }
      },
      "id": "b1a59080-5555-4f12-e7f1-8f9f098c9f80",
      "name": "Check Popularity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const repos = $node[\"Transform Repos\"].all().map(r => r.json);\nconst readmeData = $node[\"Enrich Top Repo\"].json;\nconst isTrending = $node[\"Check Popularity\"].json.output === 'true';\n\nlet readmePreview = \"No preview available.\";\nif (readmeData && readmeData.content) {\n  const decoded = Buffer.from(readmeData.content, 'base64').toString('utf8');\n  readmePreview = decoded.substring(0, 300) + \"...\";\n}\n\nconst date = new Date().toLocaleDateString();\nconst label = isTrending ? \"🔥 Trending\" : \"📌 Notable\";\n\nlet digest = `📊 GitHub Morning Brief — ${date}\\n\\n`;\ndigest += `Status: ${label}\\n\\n`;\ndigest += \"Top 5 JavaScript Repos:\\n\";\n\nrepos.forEach((repo, index) => {\n  digest += `${index + 1}. **${repo.name}** (${repo.stars} stars) [${repo.language}]\\n   ${repo.description || 'No description'}\\n   ${repo.url}\\n\\n`;\n});\n\ndigest += `\\n📖 README Preview (${repos[0].name}):\\n${readmePreview}`;\n\nreturn { digest };"
      },
      "id": "a0948070-4444-4012-f7f1-8f9f098c9f80",
      "name": "Format Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$credentials.url}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "discordWebhookApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{$json.digest}}"
            }
          ]
        },
        "options": {}
      },
      "id": "9f837060-3333-4112-07f1-8f9f098c9f80",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1350,
        300
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "2",
          "name": "Discord Webhook"
        }
      }
    },
    {
      "parameters": {},
      "id": "8e726050-2222-4212-17f1-8f9f098c9f80",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        1150,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$credentials.url}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "discordWebhookApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "=⚠️ Morning Brief failed: {{$json.error.message}}"
            }
          ]
        },
        "options": {}
      },
      "id": "7d615040-1111-4312-27f1-8f9f098c9f80",
      "name": "Send Error to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1350,
        500
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "2",
          "name": "Discord Webhook"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch GitHub Repos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch GitHub Repos": {
      "main": [
        [
          {
            "node": "Transform Repos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform Repos": {
      "main": [
        [
          {
            "node": "Enrich Top Repo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enrich Top Repo": {
      "main": [
        [
          {
            "node": "Check Popularity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Popularity": {
      "main": [
        [
          {
            "node": "Format Digest",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Digest",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Format Digest": {
      "main": [
        [
          {
            "node": "Send to Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Send Error to Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
